# Copy this file to .env and fill in locally. Never commit .env or real keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_YOUR_SERVER_SECRET
# Writes remain disabled unless BOTH values are explicitly set as below.
# Never enable on a deployed/public server. No administrator authentication yet.
NODE_ENV=development
ENABLE_DEV_MATCH_WRITES=false
